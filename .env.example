# Copy to .env and fill in your values. Never commit .env.
#   cp .env.example .env

# Directory containing the SSH private key for the tunnel (mounted read-only)
SSH_KEY_DIR=$HOME/.ssh

# OneFS cluster reachable through the jump host
MGMT_IP=192.168.1.9
MGMT_PORT=8080

# SSH jump host for the tunnel
JUMPHOST=10.241.80.184
JUMPPORT=22

# OneFS API credentials
ISILON_USER=root
ISILON_PASS=

# Seconds between scrape loops
SCRAPE_INTERVAL=30

# v2 multi-cluster (optional): JSON list of {"name","host","port","user","password"}.
# When set, ISILON_HOST/ISILON_PORT/ISILON_USER/ISILON_PASS are ignored.
# ISILON_TARGETS=[{"name":"prod","host":"10.0.0.1","password":"..."}]
